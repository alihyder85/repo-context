# Environment Configuration
# Copy this file to .env and update values as needed

# Database
DATABASE_URL=sqlite:///code_indexer.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/code_indexer.log

# Scanner
IGNORE_PATTERNS=.git,__pycache__,*.pyc,node_modules,.venv
MAX_FILE_SIZE_MB=10

# API
API_HOST=0.0.0.0
API_PORT=8000

# Development
DEBUG=true